# Elastic Stack images. Keep all components on the same version.
STACK_VERSION=9.4.4

# Elasticsearch and Kibana are localhost-only by default.
ES_PORT=9200
KIBANA_PORT=5601

# Filebeat agents connect to this port. For extra safety, replace 0.0.0.0
# with this server's private-network IP and restrict the port in the firewall.
LOGSTASH_BIND_ADDRESS=0.0.0.0
LOGSTASH_BEATS_PORT=5044

# Small-VM defaults. Increase these values when ingest volume grows.
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms256m -Xmx256m

