# Elastic Stack images. Keep all components on the same version.
STACK_VERSION=9.4.4

# Authentication. Replace every value before starting the stack.
# For this simple setup, use only letters and numbers (at least 8 characters).
ELASTIC_PASSWORD=ReplaceWithElasticPassword123
KIBANA_PASSWORD=ReplaceWithKibanaPassword123
LOGSTASH_PASSWORD=ReplaceWithLogstashPassword123

# Stable Kibana session/saved-object encryption keys (at least 32 characters).
# Generate separate values with: openssl rand -hex 32
KIBANA_SECURITY_ENCRYPTION_KEY=ReplaceWithKibanaSecurityKey1234567890
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=ReplaceWithKibanaSavedObjectsKey123456
KIBANA_REPORTING_ENCRYPTION_KEY=ReplaceWithKibanaReportingKey123456789

# Elasticsearch and Kibana are localhost-only by default.
ES_PORT=9200
KIBANA_PORT=5601

# Filebeat agents connect to this port. For extra safety, replace 0.0.0.0
# with this server's private-network IP and restrict the port in the firewall.
LOGSTASH_BIND_ADDRESS=0.0.0.0
LOGSTASH_BEATS_PORT=5044

# Small-VM defaults. Increase these values when ingest volume grows.
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms256m -Xmx256m
