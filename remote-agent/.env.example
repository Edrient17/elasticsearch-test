# Private IP or DNS name of the VM running the Elastic server.
LOGSTASH_HOST=10.0.0.10:5044

# This value appears as host.name in Kibana.
VM_NAME=application-vm-01

# Set to true to also collect this VM's Docker container JSON logs.
COLLECT_DOCKER_LOGS=false

# Must match the server stack version.
STACK_VERSION=9.4.4

